{
    "name": "capevace/livewire-optimistic-ui",
    "description": "Optimistic UI for Livewire: mark actions #[Optimistic] and the page updates before the server answers, with automatic rollback.",
    "keywords": [
        "Lukas Mateffy",
        "laravel",
        "livewire",
        "optimistic-ui"
    ],
    "homepage": "https://github.com/capevace/livewire-optimistic-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "Lukas Mateffy",
            "email": "github@mateffy.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0||^13.0",
        "livewire/livewire": "^4.4",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Capevace\\OptimisticUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capevace\\OptimisticUI\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "test": "vendor/bin/pest --testsuite=Unit",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --testsuite=Unit --coverage --min=100",
        "format": "vendor/bin/pint",
        "test-js": "bun test",
        "build-js": "bun run build",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve --port=8077"
        ],
        "test-browser": "vendor/bin/pest --testsuite=Browser"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capevace\\OptimisticUI\\OptimisticServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
